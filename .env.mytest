DB_USERNAME=izsuite
DB_PASSWORD=local_secret
DB_ROOT_PASSWORD=local_root_secret

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

MAIL_MAILER=log
BROADCAST_CONNECTION=log
LOG_LEVEL=debug
