# Local test environment. Gitignored — never committed.
# The server's .env is separate and holds real secrets.

APP_NAME=izSuite
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:9whtHMCSfgl5l+/TATObdJDUx8EWHu+0R/wahm1tIeQ=
